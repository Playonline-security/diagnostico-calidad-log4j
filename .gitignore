# Archivos locales del entorno (no versionar)
.idea/
*.iml
.vscode/

# Material interno de trabajo (no publicar, uso personal)
docs/

# Salidas de Maven y archivos compilados
target/
out/
*.class
dependency-reduced-pom.xml

# Artefactos generados por Jazzer (corpus, inputs y ficheros de fallo)
.cifuzz-corpus/
**/*Inputs/
crash-*

# Registros y archivos temporales de herramientas de desarrollo
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store

# Vista publica por tecnica (copias sanitizadas con trazabilidad).
# Solo se versiona evidencias/resultados/. Los originales en
# evidencias/ejecuciones/ y los historicos F-05/F-06B permanecen locales
# (sin excepciones que los habiliten).
!evidencias/resultados/
!evidencias/resultados/**/*.log
!evidencias/resultados/**/*.md
!evidencias/resultados/**/*.json
!evidencias/resultados/**/*.xml
!evidencias/resultados/**/*.html
!evidencias/resultados/**/reportes/
!evidencias/resultados/**/entradas-reproduccion/
!evidencias/resultados/**/entradas-reproduccion/crash-*
